new file mode 100644
index 0000000..336e8fe
--- /dev/null
+++ b/src/components/widgets/bedmesh/M300PadContactMap.vue
@@ -0,0 +1,242 @@
+<template>
+  <collapsable-card
+    v-if="map"
+    title="M300 contact areas — top view"
+    icon="$bedMesh"
+    :lazy="false"
+    class="mb-2 mb-md-4"
+  >
+    <v-card-text>
+      <svg
+        class="m300-contact-map"
+        :viewBox="viewBox"
+        role="img"
+        aria-label="Top view of the five contact areas, probe positions and live nozzle position"
+      >
+        <rect
+          class="map-bed"
+          :x="map.minX"
+          :y="map.minY"
+          :width="map.maxX - map.minX"
+          :height="map.maxY - map.minY"
+        />
+        <g class="map-grid">
+          <line
+            v-for="x in ticksX"
+            :key="`x${x}`"
+            :x1="x"
+            :x2="x"
+            :y1="map.minY"
+            :y2="map.maxY"
+          />
+          <line
+            v-for="y in ticksY"
+            :key="`y${y}`"
+            :x1="map.minX"
+            :x2="map.maxX"
+            :y1="y"
+            :y2="y"
+          />
+        </g>
+        <g class="map-axes">
+          <text
+            v-for="x in ticksX"
+            :key="`x${x}`"
+            :x="x"
+            :y="map.minY - 8"
+            text-anchor="middle"
+          >{{ x }}</text>
+          <text
+            v-for="y in ticksY"
+            :key="`y${y}`"
+            :x="map.minX - 7"
+            :y="y + 3"
+            text-anchor="end"
+          >{{ y }}</text>
+          <text
+            :x="map.maxX + 12"
+            :y="map.minY - 8"
+          >X</text>
+          <text
+            :x="map.minX - 14"
+            :y="map.maxY + 15"
+          >Y</text>
+        </g>
+        <g
+          v-for="region in visibleRegions"
+          :key="region.name"
+          :data-pad="region.name"
+        >
+          <rect
+            class="map-metal"
+            :x="region.x"
+            :y="region.y"
+            :width="region.width"
+            :height="region.height"
+          />
+          <text
+            class="map-pad-name"
+            :x="region.x + region.width - 6"
+            :y="region.y + 11"
+            text-anchor="end"
+          >{{ shortNames[region.name] }}</text>
+        </g>
+        <g
+          v-for="(point, index) in map.points"
+          :key="index"
+        >
+          <circle
+            v-if="inside(point)"
+            class="map-point"
+            :class="{ measured: index < map.measured, current: map.probing && index === map.measured }"
+            :data-point="index"
+            :cx="point[0]"
+            :cy="point[1]"
+            r="2.1"
+          >
+            <title>Point {{ index + 1 }}: X{{ point[0] }} / Y{{ point[1] }}</title>
+          </circle>
+          <circle
+            v-if="inside(point) && map.probing && index === map.measured"
+            class="map-target"
+            :cx="point[0]"
+            :cy="point[1]"
+            r="5"
+          />
+        </g>
+        <template v-if="head && inside(head)">
+          <circle
+            class="map-head-ring"
+            :cx="head[0]"
+            :cy="head[1]"
+            r="6"
+          />
+          <circle
+            class="map-head"
+            data-nozzle
+            :cx="head[0]"
+            :cy="head[1]"
+            r="3.5"
+          />
+        </template>
+      </svg>
+      <div class="map-legend">
