+  })
+
+  it.each(['COMPLETE', 'CANCELLED', 'FAULT', 'IDLE'])('clears the home state after %s', state => {
+    const source = printer()
+    source.m300_motion!.state = state
+    expect(readM300Homing(source)).toBeUndefined()
+  })
+
+  it('rejects inactive, disconnected and unsupported motion reports', () => {
+    for (const change of [{ busy: false }, { ready: false }, { normal_control: false },
+      { operation: '__proto__' }, { operation: 'HOME_OTHER' }]) {
+      const source = printer()
+      Object.assign(source.m300_motion!, change)
+      expect(readM300Homing(source)).toBeUndefined()
+    }
+    const source = printer()
+    source.webhooks.state = 'shutdown'
+    expect(readM300Homing(source)).toBeUndefined()
+    delete source.m300_motion
+    source.webhooks.state = 'ready'
+    expect(readM300Homing(source)).toBeUndefined()
+  })
+
+  it('uses the same OLED phase text only for the current token and phase', () => {
+    const source = printer()
+    source.m300_procedures!.phase = 1
+    expect(readM300Homing(source)?.message).toBe('Homing Z')
+    source.m300_procedures!.phase = 2
+    source.m300_procedures!.token = 4
+    expect(readM300Homing(source)?.message).toBe('Homing Z')
+    source.m300_procedures!.token = 5
+    expect(readM300Homing(source)?.message).toBe('Refining Z reference')
+  })
+
+  it('updates the actual home buttons for remote starts and clears them on completion', async () => {
+    const state = Vue.observable({ printer: { printer: printer('HOME_ALL'), forceMoveEnabled: false } })
+    const slot = { template: '<div><slot /></div>' }
+    const wrapper = shallowMount(ToolheadControlBars, {
+      mocks: {
+        $typedState: state,
+        $typedGetters: {
+          'wait/hasWait': () => false,
+          'printer/getKlippyReady': true,
+          'printer/getPrinterState': 'idle',
+          'printer/getHomedAxes': () => false
