+<script lang="ts">
+import { Component, Mixins, Watch } from 'vue-property-decorator'
+import M300LevelingDiagram from './M300LevelingDiagram.vue'
+import { readM300Brightness, readM300Leveling } from './m300Leveling'
+import type { BrightnessControl } from './m300Leveling'
+import StateMixin from '@/mixins/state'
+import type { PromptDialog, PromptDialogButton } from '@/store/console/types'
+
+@Component({ components: { M300LevelingDiagram } })
+export default class ActionCommandPromptDialog extends Mixins(StateMixin) {
+  brightnessDraft: Record<string, number> = {}
+
+  get dialog (): PromptDialog {
+    return this.$typedState.console.promptDialog
+  }
+
+  get leveling () {
+    return readM300Leveling(this.dialog)
+  }
+
+  get compactPrinterInfo () {
+    return this.dialog.title === 'ZORTRAX M300 - Printer information'
+  }
+
+  get brightness () {
+    return readM300Brightness(this.dialog)
+  }
+
+  get brightnessById (): Record<number, BrightnessControl> {
+    return Object.fromEntries(this.brightness.map(control => [control.id, control]))
+  }
+
+  @Watch('brightness')
+  clearBrightnessDraft () {
+    this.brightnessDraft = {}
+  }
+
+  brightnessLevel (control: BrightnessControl): number {
+    return this.brightnessDraft[control.key] ?? control.level
+  }
+
+  previewBrightness (control: BrightnessControl, event: Event) {
+    if (event.target instanceof HTMLInputElement) {
+      this.$set(this.brightnessDraft, control.key, event.target.valueAsNumber)
+    }
+  }
+
+  applyBrightness (control: BrightnessControl, event: Event) {
+    this.previewBrightness(control, event)
+    const level = this.brightnessLevel(control)
+    if (Number.isInteger(level) && level >= 1 && level <= 16) {
+      this.sendGcode(`ZORTRAX_UI_SETTING NAME=${control.key} VALUE=${level}`)
+    }
+  }
+
+  get visibleItems () {
+    const replaced = this.leveling?.otherIds ?? []
+    const singleBrightness = this.brightness.some(control => this.dialog.title === `ZORTRAX M300 - ${control.label}`)
+    return this.dialog.items.filter(item => !replaced.includes(item.id) &&
+      !(singleBrightness && item.type === 'button' && /^(?:[1-9]|1[0-6])(?: <)?$/.test(item.text)))
+  }
+
+  get open (): boolean {
+    return this.dialog.open
+  }
+
+  set open (value: boolean) {
+    if (!value) {
+      this.sendGcode('RESPOND TYPE=command MSG="action:prompt_end"')
+    }
+  }
+
+  handleClick (button: PromptDialogButton) {
+    this.sendGcode(button.command || button.text)
+  }
+}
+</script>
