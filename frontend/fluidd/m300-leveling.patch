+// SPDX-License-Identifier: GPL-3.0-only
+// @vitest-environment jsdom
+import { describe, expect, it, vi } from 'vitest'
+import { mount, shallowMount } from '@vue/test-utils'
+import Vue from 'vue'
+import ActionCommandPromptDialog from './ActionCommandPromptDialog.vue'
+import M300LevelingDiagram from './M300LevelingDiagram.vue'
+import { readM300Brightness, readM300Leveling } from './m300Leveling'
+import type { PromptDialogItem } from '@/store/console/types'
+
+vi.mock('@/mixins/state', async () => ({ default: (await import('vue')).default }))
+
+const title = 'ZORTRAX M300 - Platform leveling'
+const offsets = ['4: -0.1 mm', '3: 0.1 mm', '2: -0.1 mm', '1: -0.4 mm', '0: 0.0 mm']
+
+function dialog (rows = offsets) {
+  const text = ['Calibration done.', 'Press the button to continue', ...rows]
+  const items: PromptDialogItem[] = text.map((text, id) => ({ id, type: 'text', text }))
+  items.push({ id: 99, type: 'button', text: 'Continue', command: 'ZORTRAX_PROCEDURE_ACTION' })
+  return { title, items }
+}
+
+describe('M300 calibration result', () => {
+  it('places the OLED values on the matching physical locations and preserves the button', () => {
+    const source = dialog()
+    const result = readM300Leveling(source)
+    expect(result?.points.map(({ id, name, value }) => [id, name, value])).toEqual([
+      [4, 'Rear left', '-0.1'],
+      [3, 'Rear right', '0.1'],
+      [2, 'Center', '-0.1'],
+      [1, 'Front left', '-0.4'],
+      [0, 'Front right', '0.0']
+    ])
+    expect(result?.firstId).toBe(2)
+    expect(result?.otherIds).toEqual([3, 4, 5, 6])
+    expect(source.items.at(-1)).toMatchObject({ type: 'button', command: 'ZORTRAX_PROCEDURE_ACTION' })
+  })
+
+  it('renders five accessible readings and their physical orientation', () => {
+    const points = readM300Leveling(dialog())?.points
+    const diagram = mount(M300LevelingDiagram, { propsData: { points } })
+    expect(diagram.findAll('circle')).toHaveLength(5)
+    expect(diagram.find('svg').attributes('aria-label')).toContain('Front left: -0.4 mm')
+    expect(diagram.findAll('text').wrappers.map(row => row.text()))
+      .toEqual(['-0.1 mm', '0.1 mm', '-0.1 mm', '-0.4 mm', '0.0 mm', 'Front'])
+    expect(diagram.findAll('circle').at(0).attributes('cy')).toBe('31')
+    expect(diagram.findAll('circle').at(4).attributes('cy')).toBe('147')
+    diagram.destroy()
+  })
+
+  it('keeps standard text for unrelated or incomplete prompts and rejects malformed rows', () => {
+    expect(readM300Leveling({ ...dialog(), title: 'Different prompt' })).toBeNull()
+    expect(readM300Leveling(dialog())).not.toBeNull()
+    expect(readM300Leveling(dialog([]))).toBeNull()
+    expect(readM300Leveling(dialog(offsets.slice(0, 4)))).toBeNull()
+    expect(readM300Leveling(dialog([...offsets.slice(0, 4), '0: <svg> mm']))).toBeNull()
+    expect(readM300Leveling(dialog([...offsets.slice(0, 4), '1: 0.0 mm']))).toBeNull()
+  })
+})
+
+describe('M300 information prompt', () => {
+  it.each([
+    ['ZORTRAX M300 - Printer information', 2],
+    ['ZORTRAX M300 - Help', 0]
+  ] as const)('compacts only information text in %s', (title, compactRows) => {
+    const info = {
+      title,
+      open: true,
+      items: [
+        { id: 1, type: 'button', text: 'Back', command: 'ZORTRAX_UI_ACTION' },
+        { id: 2, type: 'text', text: 'Model: Zortrax M300 Classic' },
+        { id: 3, type: 'text', text: 'Hardware version: HW05' }
+      ],
+      footerButtons: [{ id: 4, text: 'Refresh', command: 'ZORTRAX_UI_SHOW' }]
+    }
+    const slot = { template: '<div><slot /><slot name="actions" /></div>' }
+    const wrapper = shallowMount(ActionCommandPromptDialog, {
+      mocks: { $typedState: { console: { promptDialog: info } } },
+      stubs: { 'app-dialog': slot, 'v-card-text': slot, 'v-row': slot, 'v-col': slot, 'app-btn': slot }
+    })
+    expect(wrapper.findAll('.m300-printer-info-row')).toHaveLength(compactRows)
+    expect(wrapper.text()).toContain('Model: Zortrax M300 Classic')
+    expect(wrapper.text()).toContain('Hardware version: HW05')
+    expect(wrapper.text()).toContain('Back')
+    wrapper.destroy()
+  })
+})
+
+describe('M300 brightness controls', () => {
+  it('reads both controls while preserving other procedure text', () => {
+    expect(readM300Brightness({
+      title: 'ZORTRAX M300 - Platform leveling',
+      items: [
+        { id: 1, type: 'text', text: 'Heating' },
+        { id: 2, type: 'text', text: 'M300_BRIGHTNESS oled_brightness 16' },
+        { id: 3, type: 'text', text: 'M300_BRIGHTNESS led_brightness 5' },
+        { id: 4, type: 'text', text: 'M300_BRIGHTNESS led_brightness 17' }
+      ]
+    })).toEqual([
+      { id: 2, key: 'oled_brightness', label: 'OLED brightness', level: 16, savedLevel: 16 },
+      { id: 3, key: 'led_brightness', label: 'LED brightness', level: 5, savedLevel: 5 }
+    ])
+  })
+
+  const brightnessPrompt = () => ({
+    title: 'ZORTRAX M300 - LED brightness',
+    open: true,
+    items: [
+      { id: 0, type: 'button' as const, text: 'Back', command: 'ZORTRAX_UI_ACTION VIEW=012345678901234567890123 INDEX=0' },
+      { id: 1, type: 'text' as const, text: 'M300_BRIGHTNESS led_brightness 8' }
+    ],
+    footerButtons: []
+  })
+
+  it('uses subscribed OLED previews and saved values, with a validated legacy fallback', () => {
+    const prompt = brightnessPrompt()
+    expect(readM300Brightness(prompt, {
+      ready: true, brightness: { led_brightness: 13 }, settings: { led_brightness: 7 }
+    })[0]).toMatchObject({ level: 13, savedLevel: 7 })
+    for (const status of [undefined, { ready: false, brightness: { led_brightness: 13 } },
+      { ready: true, brightness: { led_brightness: 17 }, settings: { led_brightness: NaN } }]) {
+      expect(readM300Brightness(prompt, status)[0]).toMatchObject({ level: 8, savedLevel: 8 })
+    }
+  })
+
+  it('follows knob changes live and saves the displayed value without replacing Back', async () => {
+    const source = Vue.observable({
+      console: { promptDialog: brightnessPrompt() },
+      printer: {
+        printer: {
+          m300_settings: {
+            ready: true, brightness: { led_brightness: 8 }, settings: { led_brightness: 8 }
+          }
+        }
+      }
+    })
+    const sendGcode = vi.fn()
+    const slot = { template: '<div><slot /><slot name="actions" /></div>' }
+    const button = { props: ['disabled'], template: '<button :disabled="disabled" @click="$emit(\'click\')"><slot /></button>' }
+    const wrapper = shallowMount(ActionCommandPromptDialog, {
+      mocks: { $typedState: source, sendGcode },
+      stubs: { 'app-dialog': slot, 'v-card-text': slot, 'v-row': slot, 'v-col': slot, AppBtn: button }
+    })
+    expect(wrapper.findAll('.filled')).toHaveLength(8)
+    source.printer.printer.m300_settings.brightness.led_brightness = 13
+    await Vue.nextTick()
+    expect(wrapper.findAll('.filled')).toHaveLength(13)
+    const save = () => wrapper.findAll('button').wrappers.find(button => button.text() === 'Save')!
+    expect(save().attributes('disabled')).toBeUndefined()
+    await save().trigger('click')
+    expect(sendGcode).toHaveBeenLastCalledWith('ZORTRAX_UI_SETTING NAME=led_brightness VALUE=13')
+    source.printer.printer.m300_settings.settings.led_brightness = 13
+    await Vue.nextTick()
+    expect(save().attributes('disabled')).toBeDefined()
+    const back = wrapper.findAll('button').wrappers.find(button => button.text() === 'Back')!
+    await back.trigger('click')
+    expect(sendGcode).toHaveBeenLastCalledWith(source.console.promptDialog.items[0].command)
+    sendGcode.mockClear()
+    await wrapper.find('input').setValue('5')
+    expect(sendGcode).not.toHaveBeenCalled()
+    await wrapper.find('input').trigger('change')
+    expect(sendGcode).toHaveBeenLastCalledWith('ZORTRAX_UI_SETTING NAME=led_brightness VALUE=5')
+    expect(sendGcode).toHaveBeenCalledTimes(1)
+    source.printer.printer.m300_settings.brightness.led_brightness = 5
+    source.printer.printer.m300_settings.settings.led_brightness = 5
+    await Vue.nextTick()
+    expect(wrapper.findAll('.filled')).toHaveLength(5)
+    expect(save().attributes('disabled')).toBeDefined()
+    wrapper.destroy()
+  })
+})
