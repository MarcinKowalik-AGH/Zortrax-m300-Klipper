+// SPDX-License-Identifier: GPL-3.0-only
+
+// Defaults for macros introduced after an existing Fluidd preferences record.
+// An explicit valid user category is preserved by the caller.
+export function m300MacroDefaultCategory (name: string, model: unknown): string | undefined {
+  if (model !== 'M300_CLASSIC') return
+  switch (name.toUpperCase()) {
+    case 'ZORTRAX_HEAT_PLATFORM':
+    case 'ZORTRAX_FULL_PLATFORM_PREHEAT':
+      return 'ZORTRAX M300'
+    case 'START_PRINT':
+    case 'END_PRINT':
+      return 'Klipper'
+  }
+}
