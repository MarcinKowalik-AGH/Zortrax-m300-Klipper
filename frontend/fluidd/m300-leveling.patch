+<template>
+  <collapsable-card
+    v-if="status"
+    title="M300 pad measurement"
+    icon="$bedMesh"
+    :lazy="false"
+    class="mb-2 mb-md-4"
+  >
+    <v-card-text>
+      <v-progress-linear
+        v-if="status.busy"
+        :value="100 * status.points_measured / status.total_points"
+        :indeterminate="!!status.phase && status.phase !== 'PROBING'"
+        class="mb-3"
+      />
+      <v-alert
+        :type="error || status.state === 'FAILED' ? 'error' : accepted ? 'success' : 'info'"
+        text
+      >
+        <template v-if="error">
+          <strong>{{ error.label }} — {{ error.title }}</strong>
+          <div>{{ error.reason }}</div>
+          <div class="mt-2">
+            {{ error.action }}
+          </div>
+        </template>
+        <template v-else-if="status.busy">
+          <template v-if="preparationMessage">
+            {{ preparationMessage }}
+          </template>
+          <template v-else>
+            Measuring point {{ Math.min(status.points_measured + 1, 25) }} of 25.
+          </template>
+          <div v-if="status.targets">
+            <div>Nozzle actual: {{ actualTemperature('extruder') }} °C. Nozzle target: {{ status.targets.hotend.toFixed(1) }} °C.</div>
+            <div>Bed actual: {{ actualTemperature('heater_bed') }} °C. Bed target: {{ status.targets.bed.toFixed(1) }} °C.</div>
+          </div>
+        </template>
+        <template v-else-if="accepted">
+          Profile {{ profileName }} created.
+          {{ active ? 'Compensation is active.' : 'Compensation remains inactive until loaded.' }}
+        </template>
+        <template v-else>
+          No new mesh profile was created.
+        </template>
+        <div v-if="!error && status.last_error">
+          {{ status.last_error }}
+        </div>
+      </v-alert>
+      <app-btn
+        v-if="error"
+        class="mb-3"
+        @click="acknowledge"
+      >
+        Acknowledge
+      </app-btn>
+      <template v-if="status.last_attempt">
+        <p>
+          Measured range: {{ status.last_attempt.span_mm.toFixed(4) }} mm.
+          Allowed range: {{ status.last_attempt.limit_mm.toFixed(4) }} mm.
+        </p>
+        <v-simple-table dense>
+          <thead><tr><th>Pad</th><th>Median Z (mm)</th><th>Pad spread (mm)</th></tr></thead>
+          <tbody>
+            <tr
+              v-for="(pad, index) in status.last_attempt.pads"
+              :key="index"
+            >
+              <td>{{ names[index] }}</td><td>{{ pad.z.toFixed(4) }}</td><td>{{ pad.spread.toFixed(4) }}</td>
+            </tr>
+          </tbody>
+        </v-simple-table>
+      </template>
+      <app-btn
+        v-if="accepted"
+        :disabled="!klippyReady || printerBusy"
+        class="mt-3"
+        @click="save"
+      >
+        Save configuration
+      </app-btn>
+    </v-card-text>
+  </collapsable-card>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import { hasBedMeshMatrix, isM300PadMeshAccepted, readM300PadMesh } from '@/util/m300-pad-mesh'
+import { padMeshError } from '@/util/m300-feedback'
+
+@Component
+export default class M300PadMeshStatus extends Mixins(StateMixin) {
+  names = ['Front right', 'Front left', 'Center', 'Rear right', 'Rear left']
+
+  get status () {
+    return readM300PadMesh(this.$typedState.printer.printer.m300_pad_mesh)
+  }
+
+  get accepted () {
+    return isM300PadMeshAccepted(this.status)
+  }
+
+  actualTemperature (name: 'extruder' | 'heater_bed') {
+    const value = this.$typedState.printer.printer[name]?.temperature
+    return typeof value === 'number' && Number.isFinite(value) ? value.toFixed(1) : '—'
+  }
+
+  get error () {
+    return padMeshError(this.$typedState.printer.printer, this.status)
+  }
+
+  acknowledge () {
+    if (this.error && this.klippyReady) this.sendGcode(`ZORTRAX_ERROR_ACK ID=${this.error.id}`)
+  }
+
+  get preparationMessage () {
+    const messages: Record<string, string> = {
+      PREPARING: 'Preparing the pad measurement.',
+      CLEARANCE: 'Lowering the platform before XY travel.',
+      HEATING: 'Heating the nozzle and bed together; waiting for stable temperatures.',
+      HOMING: 'Establishing the native axis references.',
+      STABILIZING: 'Checking stable temperatures after homing.'
+    }
+    return messages[this.status?.phase ?? '']
+  }
+
+  get profileName () {
+    return this.status?.result?.profile
+  }
+
+  get active () {
+    const bed = this.$typedState.printer.printer.bed_mesh
+    return bed?.profile_name === this.profileName && hasBedMeshMatrix(bed?.mesh_matrix)
+  }
+
+  save () {
+    if (this.accepted && this.klippyReady && !this.printerBusy) this.sendGcode('SAVE_CONFIG')
+  }
+}
+</script>
