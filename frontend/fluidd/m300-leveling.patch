+// SPDX-License-Identifier: GPL-3.0-only
+export interface M300Homing {
+  wait: string;
+  message: string;
+}
+
+const operations: Record<string, string> = {
+  HOME_X: 'X', HOME_Y: 'Y', HOME_XY: 'XY', HOME_Z: 'Z', HOME_ALL: 'All'
+}
+
+export function readM300Homing (printer: Klipper.PrinterState): M300Homing | undefined {
+  const motion = printer.m300_motion
+  if (printer.webhooks.state !== 'ready' || !motion || motion.normal_control !== true ||
+      motion.ready !== true || motion.busy !== true || motion.state !== 'HOMING') return
+  const axis = operations[motion.operation]
+  if (typeof axis !== 'string' || !['X', 'Y', 'XY', 'Z', 'All'].includes(axis)) return
+  const procedure = printer.m300_procedures
+  const current = procedure?.owner === 'm300_motion' && procedure.busy === true &&
+    procedure.token === motion.session_token && procedure.phase === motion.phase_id
+  const message = current && typeof procedure.message === 'string' && procedure.message.trim()
+    ? procedure.message
+    : 'Homing ' + axis.toUpperCase()
+  return { wait: 'onHome' + axis, message }
+}
