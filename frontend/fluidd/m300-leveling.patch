+// SPDX-License-Identifier: GPL-3.0-only
+export interface M300PadAttempt {
+  run_id: string;
+  accepted: boolean;
+  span_mm: number;
+  limit_mm: number;
+  pads: { z: number; spread: number }[];
+}
+
+export interface M300PadMesh {
+  run_id: string;
+  state: string;
+  phase?: string;
+  targets?: { hotend: number; bed: number } | null;
+  busy: boolean;
+  points_measured: number;
+  total_points: number;
+  last_error: string;
+  last_attempt: M300PadAttempt | null;
+  result?: { profile: string; run_id: string } | null;
+}
+
+export function readM300PadMesh (value: unknown): M300PadMesh | undefined {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) return
+  const status = value as M300PadMesh | undefined
+  if (!status || typeof status.run_id !== 'string' || !/^[a-f0-9]{24}$/.test(status.run_id) ||
+      !['PROBING', 'COMPLETE', 'FAILED'].includes(status.state) ||
+      status.busy !== (status.state === 'PROBING') || status.total_points !== 25 ||
+      !Number.isInteger(status.points_measured) || status.points_measured < 0 || status.points_measured > 25 ||
+      typeof status.last_error !== 'string') return
+  if (status.phase !== undefined && !['IDLE', 'PREPARING', 'CLEARANCE', 'HEATING', 'HOMING', 'STABILIZING',
+    'PROBING', 'COMPLETE', 'FAILED'].includes(status.phase)) return
+  if (status.targets !== undefined && status.targets !== null &&
+      (!Number.isFinite(status.targets.hotend) || !Number.isFinite(status.targets.bed))) return
+  const attempt = status.last_attempt
+  if (attempt !== null && (!attempt || attempt.run_id !== status.run_id || typeof attempt.accepted !== 'boolean' ||
+      !Number.isFinite(attempt.span_mm) || !Number.isFinite(attempt.limit_mm) ||
+      attempt.span_mm < 0 || attempt.limit_mm <= 0 ||
+      !Array.isArray(attempt.pads) || attempt.pads.length !== 5 ||
+      attempt.pads.some(pad => !pad || !Number.isFinite(pad.z) || !Number.isFinite(pad.spread) || pad.spread < 0))) return
+  return status
+}
+
+export function isM300PadMeshAccepted (status: M300PadMesh | undefined): boolean {
+  return !!status && status.state === 'COMPLETE' && !status.busy && !!status.last_attempt?.accepted &&
+    status.points_measured === status.total_points && status.last_attempt.span_mm <= status.last_attempt.limit_mm &&
+    status.result?.run_id === status.run_id && typeof status.result.profile === 'string' &&
+    /^[\w-]{1,32}$/.test(status.result.profile)
+}
+
+export function m300PadMeshPreview (printer: Klipper.PrinterState): { name: string; mesh: Klipper.BedMeshState } | undefined {
+  const status = readM300PadMesh(printer.m300_pad_mesh)
+  const bed = printer.bed_mesh
+  if (!isM300PadMeshAccepted(status) || !status?.result || !bed || bed.mesh_matrix?.length) return
+  const name = status.result.profile
+  const profile = bed.profiles?.[name]
+  const params = profile?.mesh_params
+  if (!profile || !params || !Array.isArray(profile.points) || profile.points.length < 3 ||
+      profile.points.length > 65 || profile.points.some(row => !Array.isArray(row) || row.length < 3 ||
+        row.length !== profile.points[0].length || row.length > 65 || row.some(z => !Number.isFinite(z))) ||
+      ![params.min_x, params.min_y, params.max_x, params.max_y].every(Number.isFinite) ||
+      params.min_x >= params.max_x || params.min_y >= params.max_y) return
+  return {
+    name,
+    mesh: {
+      ...bed,
+      mesh_min: [params.min_x, params.min_y],
+      mesh_max: [params.max_x, params.max_y],
+      mesh_matrix: profile.points,
+      probed_matrix: profile.points
+    }
+  }
+}
