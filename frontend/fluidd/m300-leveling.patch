diff --git a/src/util/m300-pad-contact-map.ts b/src/util/m300-pad-contact-map.ts
new file mode 100644
index 0000000..34d9947
--- /dev/null
+++ b/src/util/m300-pad-contact-map.ts
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import type { M300PadSurface } from './m300-pad-mesh'
+
+export interface M300ContactRegion {
+  name: string;
+  center: [number, number];
+  bounds: [number, number, number, number];
+  explicit: boolean;
+}
+
+export interface M300ContactMap {
+  regions: M300ContactRegion[];
+  points: [number, number][];
+  minX: number;
+  minY: number;
+  maxX: number;
+  maxY: number;
+  measured: number;
+  preview: boolean;
+  probing: boolean;
+  fits: boolean;
+  heights: (number | null)[];
+  heightSource: 'contact' | 'saved_mesh' | 'none';
+  profileName?: string;
+}
+
+const names = ['front_right', 'front_left', 'center', 'rear_right', 'rear_left']
+const vector = (value: unknown, size: number): value is number[] =>
+  Array.isArray(value) && value.length === size && value.every(v => typeof v === 'number' && Number.isFinite(v))
+
+export function readM300ContactMap (value: unknown, surface?: M300PadSurface): M300ContactMap | undefined {
+  if (!value || typeof value !== 'object') return
+  const raw = value as Record<string, unknown>
+  const travel = raw.travel as Record<string, unknown> | undefined
+  if (!travel || !vector(travel.configured_x, 2) || !vector(travel.configured_y, 2) ||
+      travel.configured_x[0] >= travel.configured_x[1] || travel.configured_y[0] >= travel.configured_y[1] ||
+      !Array.isArray(raw.contact_regions) || raw.contact_regions.length !== 5 ||
+      !Array.isArray(raw.probe_points) || raw.probe_points.length !== 25 ||
+      !raw.probe_points.every(point => vector(point, 2)) ||
+      typeof raw.points_measured !== 'number' || !Number.isInteger(raw.points_measured) ||
+      raw.points_measured < 0 || raw.points_measured > 25) return
+  const regions = raw.contact_regions as M300ContactRegion[]
+  if (regions.some((region, index) => !region || region.name !== names[index] ||
+      !vector(region.bounds, 4) || !vector(region.center, 2) ||
+      region.bounds[0] >= region.bounds[2] || region.bounds[1] >= region.bounds[3] ||
+      region.center[0] <= region.bounds[0] || region.center[0] >= region.bounds[2] ||
+      region.center[1] <= region.bounds[1] || region.center[1] >= region.bounds[3])) return
+  const points = raw.probe_points as [number, number][]
+  const heights: (number | null)[] = Array(25).fill(null)
+  if (raw.plan_matches_run === true && typeof raw.run_id === 'string' && /^[a-f0-9]{24}$/.test(raw.run_id)) {
+    const attempt = raw.last_attempt as { run_id?: string; points?: unknown } | undefined
+    const measured = raw.measurements ?? (attempt?.run_id === raw.run_id ? attempt.points : undefined)
+    if (Array.isArray(measured) && measured.length === raw.points_measured && measured.length <= 25 &&
+        measured.every((point, index) => vector(point, 3) &&
+          Math.abs(point[0] - points[index][0]) < 0.000001 && Math.abs(point[1] - points[index][1]) < 0.000001)) {
+      measured.forEach((point, index) => { heights[index] = point[2] })
+    }
+  }
+  let heightSource: M300ContactMap['heightSource'] = heights.some(z => z !== null) ? 'contact' : 'none'
+  if (heightSource === 'none' && surface?.saved && raw.state === 'IDLE' && raw.busy === false) {
+    const mesh = surface.mesh
+    const grid = mesh.mesh_matrix!
+    const [x0, y0] = mesh.mesh_min!
+    const [x1, y1] = mesh.mesh_max!
+    points.forEach(([x, y], index) => {
+      if (x < x0 || x > x1 || y < y0 || y > y1) return
+      const col = (x - x0) / (x1 - x0) * (grid[0].length - 1)
+      const row = (y - y0) / (y1 - y0) * (grid.length - 1)
+      const i = Math.min(Math.floor(col), grid[0].length - 2)
+      const j = Math.min(Math.floor(row), grid.length - 2)
+      const u = col - i
+      const v = row - j
+      heights[index] = (1 - v) * ((1 - u) * grid[j][i] + u * grid[j][i + 1]) +
+        v * ((1 - u) * grid[j + 1][i] + u * grid[j + 1][i + 1])
+    })
+    if (heights.some(z => z !== null)) heightSource = 'saved_mesh'
+  }
+  return {
+    regions,
+    points,
+    heights,
+    heightSource,
+    profileName: heightSource === 'saved_mesh' ? surface?.name : undefined,
+    minX: travel.configured_x[0],
+    maxX: travel.configured_x[1],
+    minY: travel.configured_y[0],
+    maxY: travel.configured_y[1],
+    measured: raw.plan_matches_run === true ? raw.points_measured : 0,
+    preview: raw.phase === 'IDLE' || raw.plan_matches_run !== true,
+    probing: raw.busy === true && raw.phase === 'PROBING' && raw.plan_matches_run === true,
+    fits: travel.fits === true
+  }
+}
+
+export function contactAxisTicks (min: number, max: number): number[] {
+  const step = Math.max(1, Math.ceil((max - min) / 6 / 10) * 10)
+  const ticks = [min]
+  for (let value = Math.ceil((min + 0.001) / step) * step; value < max; value += step) ticks.push(value)
+  if (ticks.length > 1 && max - ticks[ticks.length - 1] < step / 2) ticks.pop()
+  ticks.push(max)
+  return ticks
+}
