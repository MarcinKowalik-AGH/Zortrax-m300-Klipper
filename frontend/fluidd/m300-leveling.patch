index 0000000..f7cc2db
--- /dev/null
+++ b/src/components/common/m300Leveling.ts
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import type { PromptDialog } from '@/store/console/types'
+
+const title = 'ZORTRAX M300 - Platform leveling'
+const points = [
+  { id: 4, name: 'Rear left', x: 58, y: 31 },
+  { id: 3, name: 'Rear right', x: 262, y: 31 },
+  { id: 2, name: 'Center', x: 160, y: 89 },
+  { id: 1, name: 'Front left', x: 58, y: 147 },
+  { id: 0, name: 'Front right', x: 262, y: 147 }
+] as const
+
+export type LevelingPoint = typeof points[number] & { value: string }
+
+export function readM300Leveling (dialog: Pick<PromptDialog, 'title' | 'items'>) {
+  if (dialog.title !== title) return null
+  const first = dialog.items.findIndex(item => item.type === 'text' && /^4: /.test(item.text))
+  if (first < 0) return null
+
+  const result: LevelingPoint[] = []
+  const ids: number[] = []
+  for (const [index, point] of points.entries()) {
+    const item = dialog.items[first + index]
+    if (item?.type !== 'text') return null
+    const match = /^([0-4]): (-?\d{1,4}\.\d) mm$/.exec(item.text)
+    if (match?.[1] !== String(point.id)) return null
+    result.push({ ...point, value: match[2] })
+    ids.push(item.id)
+  }
+  return { points: result, firstId: ids[0], otherIds: ids.slice(1) }
+}
+
+const brightnessLabels = {
+  oled_brightness: 'OLED brightness',
+  led_brightness: 'LED brightness'
+} as const
+
+export interface BrightnessControl {
+  id: number;
+  key: keyof typeof brightnessLabels;
+  label: string;
+  level: number;
+  savedLevel: number;
+}
+
+export interface BrightnessState {
+  ready?: boolean;
+  brightness?: Partial<Record<BrightnessControl['key'], number>>;
+  settings?: Partial<Record<BrightnessControl['key'], number>>;
+}
+
+function validBrightness (value: unknown): value is number {
+  return typeof value === 'number' && Number.isInteger(value) && value >= 1 && value <= 16
+}
+
+export function readM300Brightness (
+  dialog: Pick<PromptDialog, 'title' | 'items'>, status?: BrightnessState
+): BrightnessControl[] {
+  if (!dialog.title?.startsWith('ZORTRAX M300 - ')) return []
+  const controls: BrightnessControl[] = []
+  for (const item of dialog.items) {
+    if (item.type !== 'text') continue
+    const match = /^M300_BRIGHTNESS (oled_brightness|led_brightness) ([1-9]|1[0-6])$/.exec(item.text)
+    if (!match) continue
+    const key = match[1] as keyof typeof brightnessLabels
+    if (!controls.some(control => control.key === key)) {
+      const live = status?.ready === true ? status.brightness?.[key] : undefined
+      const saved = status?.ready === true ? status.settings?.[key] : undefined
+      controls.push({
+        id: item.id,
+        key,
+        label: brightnessLabels[key],
+        level: validBrightness(live) ? live : Number(match[2]),
+        savedLevel: validBrightness(saved) ? saved : Number(match[2])
+      })
+    }
+  }
+  return controls
+}
