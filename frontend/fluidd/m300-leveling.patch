+// SPDX-License-Identifier: GPL-3.0-only
+// @vitest-environment jsdom
+import Vue from 'vue'
+import { describe, expect, it, vi } from 'vitest'
+import { shallowMount } from '@vue/test-utils'
+import StateMixin from '@/mixins/state'
+import AppBtn from '@/components/ui/AppBtn.vue'
+import ToolheadControlBars from '@/components/widgets/toolhead/ToolheadControlBars.vue'
+import { readM300Homing } from './m300-homing'
+import { SocketActions } from '@/api/socketActions'
+
+vi.mock('@/api/socketActions', () => ({ SocketActions: { printerGcodeScript: vi.fn() } }))
+
+function printer (operation = 'HOME_Z') {
+  return {
+    webhooks: { state: 'ready' },
+    m300_motion: {
+      normal_control: true,
+      ready: true,
+      busy: true,
+      state: 'HOMING',
+      operation,
+      session_token: 5,
+      phase_id: 2
+    },
+    m300_procedures: {
+      owner: 'm300_motion',
+      busy: true,
+      token: 5,
+      phase: 2,
+      message: 'Refining Z reference'
+    }
+  } as unknown as Klipper.PrinterState
+}
+
+describe('M300 native home button status', () => {
+  it.each(['X', 'Y', 'XY', 'Z', 'All'])('binds %s homing to its existing wait key', axis => {
+    expect(readM300Homing(printer('HOME_' + axis.toUpperCase())))
+      .toEqual({ wait: 'onHome' + axis, message: 'Refining Z reference' })
+  })
+
+  it.each(['COMPLETE', 'CANCELLED', 'FAULT', 'IDLE'])('clears the home state after %s', state => {
+    const source = printer()
+    source.m300_motion!.state = state
+    expect(readM300Homing(source)).toBeUndefined()
+  })
+
+  it('rejects inactive, disconnected and unsupported motion reports', () => {
+    for (const change of [{ busy: false }, { ready: false }, { normal_control: false },
+      { operation: '__proto__' }, { operation: 'HOME_OTHER' }]) {
+      const source = printer()
+      Object.assign(source.m300_motion!, change)
+      expect(readM300Homing(source)).toBeUndefined()
+    }
+    const source = printer()
+    source.webhooks.state = 'shutdown'
+    expect(readM300Homing(source)).toBeUndefined()
+    delete source.m300_motion
+    source.webhooks.state = 'ready'
+    expect(readM300Homing(source)).toBeUndefined()
+  })
+
+  it('uses the same OLED phase text only for the current token and phase', () => {
+    const source = printer()
+    source.m300_procedures!.phase = 1
+    expect(readM300Homing(source)?.message).toBe('Homing Z')
+    source.m300_procedures!.phase = 2
+    source.m300_procedures!.token = 4
+    expect(readM300Homing(source)?.message).toBe('Homing Z')
+    source.m300_procedures!.token = 5
+    expect(readM300Homing(source)?.message).toBe('Refining Z reference')
+  })
+
+  it('updates the actual home buttons for remote starts and clears them on completion', async () => {
+    const state = Vue.observable({ printer: { printer: printer('HOME_ALL'), forceMoveEnabled: false } })
+    const slot = { template: '<div><slot /></div>' }
+    const wrapper = shallowMount(ToolheadControlBars, {
+      mocks: {
+        $typedState: state,
+        $typedGetters: {
+          'wait/hasWait': () => false,
+          'printer/getKlippyReady': true,
+          'printer/getPrinterState': 'idle',
+          'printer/getHomedAxes': () => false
+        },
+        $waits: { onHomeAll: 'onHomeAll', onHomeXY: 'onHomeXY' },
+        $t: (value: string) => value,
+        $typedDispatch: vi.fn()
+      },
+      stubs: { 'v-row': slot, 'v-col': slot, 'v-icon': slot }
+    })
+    const buttons = () => wrapper.findAllComponents(AppBtn)
+    expect(buttons().at(0).attributes('loading')).toBe('true')
+    expect(buttons().at(0).attributes('title')).toBe('Refining Z reference')
+    expect(buttons().at(1).attributes('loading')).toBeUndefined()
+    state.printer.printer.m300_motion!.operation = 'HOME_XY'
+    await Vue.nextTick()
+    expect(buttons().at(0).attributes('loading')).toBeUndefined()
+    expect(buttons().at(1).attributes('loading')).toBe('true')
+    state.printer.printer.m300_motion!.state = 'COMPLETE'
+    state.printer.printer.m300_motion!.busy = false
+    await Vue.nextTick()
+    expect(buttons().at(1).attributes('loading')).toBeUndefined()
+    buttons().at(1).vm.$emit('click')
+    expect(SocketActions.printerGcodeScript).toHaveBeenCalledWith('G28 X Y', { wait: 'onHomeXY' })
+    wrapper.destroy()
+  })
+
+  it('retains ordinary Fluidd waits without M300 firmware', () => {
+    const Component = Vue.extend({ mixins: [StateMixin], render: h => h('div') })
+    const source = printer()
+    delete source.m300_motion
+    const wrapper = shallowMount(Component, {
+      mocks: {
+        $typedState: { printer: { printer: source } },
+        $typedGetters: { 'wait/hasWait': () => true }
+      }
+    })
+    const vm = wrapper.vm as unknown as StateMixin
+    expect(vm.hasWait('onHomeAll')).toBe(true)
+    expect(vm.m300HomeBusy('onHomeAll')).toBe(false)
+    wrapper.destroy()
+  })
+})
