+// SPDX-License-Identifier: GPL-3.0-only
+// @vitest-environment jsdom
+import Vue from 'vue'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { shallowMount } from '@vue/test-utils'
+import type { PromptDialog } from '@/store/console/types'
+import M300PadMeshStatus from '@/components/widgets/bedmesh/M300PadMeshStatus.vue'
+import M300PadMeshObserver from '@/components/common/M300PadMeshObserver.vue'
+import AppBtn from '@/components/ui/AppBtn.vue'
+import { SocketActions } from '@/api/socketActions'
+import { duplicateM300Feedback, padMeshError, readM300Error } from './m300-feedback'
+import { readM300PadMesh } from './m300-pad-mesh'
+
+vi.mock('@/api/socketActions', () => ({ SocketActions: { printerGcodeScript: vi.fn() } }))
+
+function fixture () {
+  return {
+    webhooks: { state: 'ready' },
+    m300_pad_mesh: {
+      run_id: 'a'.repeat(24),
+      state: 'FAILED',
+      phase: 'FAILED',
+      busy: false,
+      points_measured: 25,
+      total_points: 25,
+      last_error: 'M300 pad mesh: bed span exceeds 0.8000 mm',
+      last_attempt: null
+    },
+    m300_errors: {
+      current: {
+        id: 'c43e7a1b06ed64c8-1',
+        view_revision: 1,
+        surface: 'pad_mesh',
+        run_id: 'a'.repeat(24),
+        title: 'Calibration failed',
+        label: 'Error #041',
+        action: 'Check the measurement results.',
+        reason: 'M300 pad mesh: bed span exceeds 0.8000 mm',
+        fatal: false
+      }
+    }
+  }
+}
+
+describe('one M300 procedure feedback surface', () => {
+  beforeEach(() => vi.clearAllMocks())
+
+  it('suppresses only an exact duplicate of an actual typed nonfatal error', () => {
+    const source = fixture() as unknown as Klipper.PrinterState
+    const reason = readM300Error(source)!.reason
+    expect(duplicateM300Feedback('!! ' + reason, source)).toBe(true)
+    for (const message of ['MCU shutdown: Timer too close', 'Probe samples exceed tolerance', reason + ' changed', null]) {
+      expect(duplicateM300Feedback(message, source)).toBe(false)
+    }
+    source.m300_pad_mesh!.run_id = 'b'.repeat(24)
+    expect(duplicateM300Feedback(reason, source)).toBe(false)
+    delete source.m300_errors
+    expect(duplicateM300Feedback(reason, source)).toBe(false)
+  })
+
+  it('uses an actual acknowledgement prompt before object-status delivery and preserves fatal notices', () => {
+    const source = fixture() as unknown as Klipper.PrinterState
+    const reason = readM300Error(source)!.reason
+    source.m300_errors!.current.fatal = true
+    expect(duplicateM300Feedback(reason, source)).toBe(false)
+    const dialog: PromptDialog = {
+      open: true,
+      title: 'ZORTRAX M300 - Error #041',
+      pendingItems: null,
+      items: [{ id: 1, type: 'text', text: 'Cause: ' + reason }],
+      footerButtons: [{ id: 2, text: 'Acknowledge', command: 'ZORTRAX_ERROR_ACK ID=c43e7a1b06ed64c8-1' }]
+    }
+    delete source.m300_errors
+    expect(duplicateM300Feedback(reason, source, dialog)).toBe(true)
+    dialog.footerButtons = []
+    expect(duplicateM300Feedback(reason, source, dialog)).toBe(false)
+  })
+
+  it('does not attach another run or a fatal shutdown to the measurement panel', () => {
+    const source = fixture() as unknown as Klipper.PrinterState
+    const status = readM300PadMesh(source.m300_pad_mesh)
+    expect(padMeshError(source, status)?.id).toBe('c43e7a1b06ed64c8-1')
+    source.m300_errors!.current.run_id = 'b'.repeat(24)
+    expect(padMeshError(source, status)).toBeUndefined()
+    source.m300_errors!.current.run_id = 'a'.repeat(24)
+    source.m300_errors!.current.fatal = true
+    expect(padMeshError(source, status)).toBeUndefined()
+  })
+
+  it('shows one cause with the shared code and acknowledgement in the Tune panel', async () => {
+    const source = fixture()
+    const state = Vue.observable({ printer: { printer: source } })
+    const slot = { template: '<section><slot /></section>' }
+    const wrapper = shallowMount(M300PadMeshStatus, {
+      mocks: {
+        $typedState: state,
+        $typedDispatch: vi.fn(),
+        $typedGetters: { 'printer/getKlippyReady': true, 'printer/getPrinterState': 'idle' }
+      },
+      stubs: { 'collapsable-card': slot, 'v-card-text': slot, 'v-alert': slot }
+    })
+    expect(wrapper.text().split(source.m300_errors.current.reason)).toHaveLength(2)
+    expect(wrapper.text()).toContain('Error #041 — Calibration failed')
+    expect(wrapper.text()).not.toContain('No new mesh profile was created.')
+    wrapper.findComponent(AppBtn).vm.$emit('click')
+    expect(SocketActions.printerGcodeScript).toHaveBeenCalledWith('ZORTRAX_ERROR_ACK ID=c43e7a1b06ed64c8-1', { wait: undefined })
+    wrapper.destroy()
+  })
+
+  it('opens the canonical panel once for a new failure, including a reconnected client', async () => {
+    const source = fixture()
+    const state = Vue.observable({ printer: { printer: source } })
+    const push = vi.fn().mockResolvedValue(undefined)
+    const wrapper = shallowMount(M300PadMeshObserver, {
+      mocks: {
+        $typedState: state,
+        $route: { name: 'home', query: { printer: 'm300' } },
+        $router: { push },
+        $typedGetters: { 'printer/getKlippyReady': true }
+      }
+    })
+    expect(push).toHaveBeenCalledTimes(1)
+    source.m300_errors.current.reason += ' details'
+    await Vue.nextTick()
+    expect(push).toHaveBeenCalledTimes(1)
+    source.m300_errors.current.id = 'c43e7a1b06ed64c8-2'
+    await Vue.nextTick()
+    expect(push).toHaveBeenCalledTimes(2)
+    source.m300_errors.current.view_revision = 2
+    await Vue.nextTick()
+    expect(push).toHaveBeenCalledTimes(3)
+    wrapper.destroy()
+  })
+})
