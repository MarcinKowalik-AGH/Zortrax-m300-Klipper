+        <span><i class="nozzle" />Nozzle</span>
+      </div>
+      <div class="mt-2 text-caption">
+        <div v-if="map.preview">
+          Plan preview · 25 positions.
+        </div>
+        X increases to the right; Y increases downwards. Coordinates in mm.
+        <div v-if="head">
+          Nozzle X{{ head[0].toFixed(1) }} / Y{{ head[1].toFixed(1) }}.
+        </div>
+        <div v-else>
+          Nozzle position is available after XY homing.
+        </div>
+      </div>
+      <v-alert
+        v-if="map.regions.some(region => !region.explicit)"
+        type="info"
+        text
+        class="mt-2 mb-0"
+      >
+        Areas follow the configured pad sizes and centers. Set per-pad BOUNDS to use measured contact areas.
+      </v-alert>
+      <v-alert
+        v-if="!map.fits"
+        type="warning"
+        text
+        class="mt-2 mb-0"
+      >
+        The configured probe plan includes positions outside XY travel. Review the geometry before measuring.
+      </v-alert>
+    </v-card-text>
+  </collapsable-card>
+</template>
+
+<script lang="ts">
+import { Component, Mixins } from 'vue-property-decorator'
+import StateMixin from '@/mixins/state'
+import { contactAxisTicks, readM300ContactMap } from '@/util/m300-pad-contact-map'
+
+@Component
+export default class M300PadContactMap extends Mixins(StateMixin) {
+  shortNames: Record<string, string> = {
+    front_left: 'FL', front_right: 'FR', center: 'C', rear_left: 'RL', rear_right: 'RR'
+  }
+
+  get map () {
+    return readM300ContactMap(this.$typedState.printer.printer.m300_pad_mesh)
+  }
+
+  get viewBox () {
+    const map = this.map
+    return map ? `${map.minX - 28} ${map.minY - 22} ${map.maxX - map.minX + 50} ${map.maxY - map.minY + 45}` : ''
+  }
+
+  get ticksX () { return this.map ? contactAxisTicks(this.map.minX, this.map.maxX) : [] }
+  get ticksY () { return this.map ? contactAxisTicks(this.map.minY, this.map.maxY) : [] }
+
+  get visibleRegions () {
+    const map = this.map
+    if (!map) return []
+    return map.regions.map(region => {
+      const x = Math.max(map.minX, region.bounds[0])
+      const y = Math.max(map.minY, region.bounds[1])
+      return {
+        name: region.name,
+        x,
+        y,
+        width: Math.max(0, Math.min(map.maxX, region.bounds[2]) - x),
+        height: Math.max(0, Math.min(map.maxY, region.bounds[3]) - y)
+      }
+    }).filter(region => region.width > 0 && region.height > 0)
+  }
+
+  get head (): [number, number] | undefined {
+    const printer = this.$typedState.printer.printer
+    const homed = printer.toolhead?.homed_axes ?? ''
+    const position = printer.motion_report?.live_position
+    if (!this.klippyReady || !homed.includes('x') || !homed.includes('y') ||
+        !position || position.length < 2 || !position.slice(0, 2).every(Number.isFinite)) return
+    return [position[0], position[1]]
+  }
+
+  inside (point: [number, number]) {
+    const map = this.map
+    return !!map && point[0] >= map.minX && point[0] <= map.maxX && point[1] >= map.minY && point[1] <= map.maxY
+  }
+}
+</script>
+
+<style scoped>
+.m300-contact-map { display: block; width: 100%; height: auto; aspect-ratio: 1; max-height: 560px; background: #141b23; border-radius: 4px; }
+.map-bed { fill: #19222c; stroke: #798797; stroke-width: 0.6; }
+.map-grid line { stroke: #344352; stroke-width: 0.3; }
+.map-axes text { fill: #c9d3df; font: 8px sans-serif; }
+.map-metal { fill: #244e40; stroke: #70be95; stroke-width: 0.7; }
+.map-pad-name { fill: #a8cab7; opacity: 0.65; font: bold 9px sans-serif; }
+.map-point { fill: #a7b5c5; stroke: #141b23; stroke-width: 0.5; }
+.map-point.measured { fill: #65e79b; }
+.map-point.current { fill: #ffbd59; }
+.map-target { fill: none; stroke: #ffbd59; stroke-width: 1; animation: contact-pulse 1.2s ease-in-out infinite; }
+.map-head-ring { fill: #141b23; fill-opacity: 0.5; stroke: white; stroke-width: 0.8; }
+.map-head { fill: #49c8ff; stroke: #041b2c; stroke-width: 0.8; }
+.map-head, .map-head-ring { transition: cx 180ms linear, cy 180ms linear; }
+.map-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 10px; font-size: 12px; }
+.map-legend span { display: inline-flex; align-items: center; gap: 6px; }
+.map-legend i { display: inline-block; width: 10px; height: 10px; border-radius: 50%; }
+.map-legend .metal { background: #244e40; border: 1px solid #70be95; border-radius: 1px; }
+.map-legend .measured { background: #65e79b; }
+.map-legend .current { background: #ffbd59; }
+.map-legend .nozzle { background: #49c8ff; }
+@keyframes contact-pulse { 50% { opacity: 0.25; } }
+@media (prefers-reduced-motion: reduce) {
+  .map-target { animation: none; }
+  .map-head, .map-head-ring { transition: none; }
+}
+</style>
