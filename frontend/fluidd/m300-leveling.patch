--- /dev/null
+++ b/src/util/m300-feedback.ts
@@ -0,0 +1,45 @@
+// SPDX-License-Identifier: GPL-3.0-only
+import type { PromptDialog } from '@/store/console/types'
+import { readM300PadMesh, type M300PadMesh } from './m300-pad-mesh'
+
+export interface M300Error {
+  id: string;
+  reason: string;
+  title: string;
+  label: string;
+  action: string;
+  fatal: boolean;
+  surface?: string;
+  run_id?: string;
+  view_revision?: number;
+}
+
+export function readM300Error (printer: Klipper.PrinterState): M300Error | undefined {
+  const error = printer.m300_errors?.current as M300Error | undefined
+  if (!error || !/^[a-f0-9]{16}-[1-9]\d*$/.test(error.id) ||
+      typeof error.fatal !== 'boolean' ||
+      (error.view_revision !== undefined && (!Number.isSafeInteger(error.view_revision) || error.view_revision < 1)) ||
+      ![error.reason, error.title, error.label, error.action].every(value => typeof value === 'string' && value.trim())) return
+  return error
+}
+
+export function padMeshError (printer: Klipper.PrinterState, status?: M300PadMesh): M300Error | undefined {
+  const error = readM300Error(printer)
+  return status && error?.surface === 'pad_mesh' && error.run_id === status.run_id && !error.fatal ? error : undefined
+}
+
+const normalize = (text: string) => text.replace(/^!!\s*/, '').replace(/\s+/g, ' ').trim().slice(0, 600)
+
+export function duplicateM300Feedback (text: unknown, printer: Klipper.PrinterState, dialog?: PromptDialog): boolean {
+  if (typeof text !== 'string' || !text.trim()) return false
+  const error = readM300Error(printer)
+  if (error && !error.fatal && normalize(text) === normalize(error.reason) &&
+      (error.surface !== 'pad_mesh' || padMeshError(printer, readM300PadMesh(printer.m300_pad_mesh)))) return true
+  // Prompt messages may arrive before the next object-status subscription.
+  // Match the actual error acknowledgement and exact cause, never all errors
+  // from an active procedure or a generic substring such as "probe".
+  return !!dialog?.open && dialog.title?.startsWith('ZORTRAX M300 - ') === true &&
+    dialog.footerButtons.some(button => /^ZORTRAX_ERROR_ACK ID=[a-f0-9]{16}-[1-9]\d*$/.test(button.command ?? '')) &&
+    dialog.items.some(item => item.type === 'text' && item.text.startsWith('Cause: ') &&
+      normalize(item.text.slice(7)) === normalize(text))
+}
