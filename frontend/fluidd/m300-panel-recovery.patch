@@ -190,22 +200,47 @@
     // If the socket is already marked disconnected, there is nothing left to do.
     if (this.store.state.socket.status === 'disconnected') return

-    // retryCount counts failed opens in a chain; ws.onopen zeroes it on any
-    // successful open, so we just increment here and give up at the cap.
-    this.retryCount += 1
-
-    if (this.retryCount > ALLOWED_RETRIES) {
-      this.store.typedDispatch('socket/onSetStatus', 'disconnected')
-      this.clearCacheAndRequests()
-      this.connection = null
-      return
-    }
+    this.stopWatchdog()
+    this.clearCacheAndRequests()
+    this.connection = null
+    const delay = Math.min(MAX_RETRY_MS, 1000 * 1.4 ** Math.min(++this.retryCount, 11))

     this.store.typedDispatch('socket/onSetStatus', 'connecting')
     this.reconnectTimeout = setTimeout(() => {
       this.reconnectTimeout = null
       this.openSocket()
-    }, EXPONENTIAL_BACKOFF ** this.retryCount * 1000)
+    }, delay)
+  }
+
+  private stopWatchdog () {
+    if (this.watchdog !== null) {
+      clearTimeout(this.watchdog)
+      this.watchdog = null
+    }
+  }
+
+  private watchSocket (socket: WebSocket) {
+    this.stopWatchdog()
+    this.watchdog = setTimeout(() => {
+      if (socket !== this.connection) return
+      if (this.store.state.socket.status !== 'ready' || Date.now() - this.lastMessageAt < QUIET_SOCKET_MS) {
+        this.watchSocket(socket)
+        return
+      }
+
+      // Ordinary throttled tabs may be quiet. Confirm with a read-only RPC.
+      this.watchdog = setTimeout(() => {
+        if (socket !== this.connection) return
+        this.close()
+        this.handleClose()
+      }, PROBE_TIMEOUT_MS)
+      this.emit('server.info', { suppressError: true }).then(() => {
+        if (socket === this.connection) this.watchSocket(socket)
+      }, () => {
+        // Any RPC response demonstrates a live connection, including an error.
+        if (socket === this.connection && socket.readyState === WebSocket.OPEN) this.watchSocket(socket)
+      })
+    }, QUIET_SOCKET_MS)
   }

